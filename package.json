{
  "name": "@iomete/jupyter-renderer-react",
  "version": "0.1.0",
  "description": "React component library for IOMETE Jupiter parser",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dist/index.css": "./dist/esm/index.css",
    "./dist/esm/index.css": "./dist/esm/index.css",
    "./dist/cjs/index.css": "./dist/cjs/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "test": "vitest",
    "test:watch": "vitest watch",
    "storybook": "storybook dev -p 6006",
    "storybook:clean": "pkill -f 'storybook dev' || true && rm -rf node_modules/.cache/storybook",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "iomete",
    "jupiter",
    "parser",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/marked": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.6.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/iomete-jupiter-parser.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/iomete-jupiter-parser/issues"
  },
  "homepage": "https://github.com/yourusername/iomete-jupiter-parser#readme",
  "dependencies": {
    "@jupyterlab/codemirror": "^4.5.11",
    "@jupyterlab/theme-dark-extension": "^4.5.11",
    "@jupyterlab/theme-light-extension": "^4.5.11",
    "@jupyterlab/ui-components": "^4.5.11",
    "marked": "^16.4.2"
  },
  "overrides": {
    "sanitize-html": "2.18.0"
  }
}
